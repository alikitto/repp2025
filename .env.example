# .env.example (скопируй значения в Railway Variables)
# Локально: cp .env.example .env && chmod 600 .env
TZ=Asia/Baku
DB_HOST=containers-xx-railway.app
DB_PORT=3306
DB_NAME=railway
DB_USER=root
DB_PASS=secret

# TG и Google — только Настройки (админ), не сюда.

# Бэкап в Google Drive (или через Настройки → Интеграции)
APP_URL=http://127.0.0.1:3000
# Шифрование токенов и дампов. Если пусто — создастся data/app_secret (32 байта).
# Смена ключа ломает расшифровку секретов и старых бэкапов.
APP_SECRET=change-me-to-a-long-random-string
# APP_DEBUG=1
# DB_SSL=1
# Только за реальным прокси (Railway, nginx). Иначе клиент может подделать IP.
# TRUST_PROXY=1
# На VPS: APP_SECRET / APP_URL / TRUST_PROXY — в env контейнера, не в корне сайта.
